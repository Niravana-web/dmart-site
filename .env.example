# Contact form delivery (Resend). Copy to .env and fill in.
# Key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender address — the domain must be verified in Resend before this will send.
# A display name is optional: BOOKING_EMAIL_FROM="DMart <notifications@example.com>"
BOOKING_EMAIL_FROM=notifications@example.com
